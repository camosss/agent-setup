#!/usr/bin/env bash
# 조율 세션 옆에 플랫폼별 Claude 작업 세션을 열고 지시를 넣는다. 끝난 세션은 닫는다
#
#   work-sessions open  --project 3872 --session server=~/Desktop/server-3872 \
#                       --session ios=~/Desktop/ios-app-3872 [--prompt-dir DIR]
#   work-sessions close --project 3872 [--platform ios] [--force]
#   work-sessions list  [--project 3872]
#
# prompt-dir 에 common.md 가 있으면 각 플랫폼 지시(<platform>.md) 앞에 붙여 보낸다
set -euo pipefail

die() { echo "오류: $*" >&2; exit 1; }
json() { python3 -c "import sys,json;d=json.load(sys.stdin);print($1)"; }

[[ "${HERDR_ENV:-}" == 1 ]] || die "Herdr 안에서 실행 중이 아닙니다"
command -v herdr >/dev/null || die "herdr 가 없습니다"

cmd="${1:-}"; shift || true
project=""; prompt_dir=""; herdr_session="${HERDR_TARGET_SESSION:-}"; specs=(); platform_only=""; force=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="$2"; shift 2 ;;
    --session) specs+=("$2"); shift 2 ;;
    --prompt-dir) prompt_dir="$2"; shift 2 ;;
    --platform) platform_only="$2"; shift 2 ;;
    --force) force=1; shift ;;
    --herdr-session) herdr_session="$2"; shift 2 ;;
    *) die "모르는 인자: $1" ;;
  esac
done

if [[ -z "$herdr_session" ]]; then
  herdr_session=$(herdr session list --json | json '",".join(s["name"] for s in d["sessions"] if s.get("running"))')
  [[ "$herdr_session" != *,* && -n "$herdr_session" ]] || die "실행 중인 Herdr 세션이 하나가 아닙니다($herdr_session). --herdr-session 으로 지정하세요"
fi
h() { herdr --session "$herdr_session" "$@"; }

# 조율 세션 패널: 이 스크립트를 부른 Claude 의 패널
self_json=$(h pane current --current) || die "현재 패널을 찾지 못했습니다"
self_pane=$(echo "$self_json" | json 'd["result"]["pane"]["pane_id"]')
self_tab=$(echo "$self_json" | json 'd["result"]["pane"]["tab_id"]')

agents_json() { h agent list; }

case "$cmd" in
open)
  [[ -n "$project" ]] || die "--project 가 필요합니다"
  [[ ${#specs[@]} -gt 0 ]] || die "--session platform=cwd 를 하나 이상 주세요"

  # 플랫폼 이름 → 패널 제목
  title_of() {
    case "$1" in
      server) echo Server ;; ios) echo iOS ;; android) echo Android ;; web) echo Web ;;
      *) echo "$1" ;;
    esac
  }

  h pane rename "$self_pane" 검증 >/dev/null

  for spec in "${specs[@]}"; do
    platform="${spec%%=*}"; cwd="${spec#*=}"; cwd="${cwd/#\~/$HOME}"
    [[ -d "$cwd" ]] || die "작업 경로가 없습니다: $cwd (worktree 를 먼저 만드세요)"
    # Herdr 에이전트 이름은 영소문자로 시작해야 한다
    name="p${project}-${platform}"
    [[ "$name" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "에이전트 이름 형식이 맞지 않습니다: $name"

    layout=$(h pane layout --pane "$self_pane")
    pane_count=$(echo "$layout" | json 'len(d["result"]["layout"]["panes"])')
    # 맨 오른쪽 아래 패널 옆에 붙인다. 4칸을 넘으면 아래로 나눈다
    anchor=$(echo "$layout" | json 'max(d["result"]["layout"]["panes"], key=lambda p:(p["rect"]["x"]+p["rect"]["width"], p["rect"]["y"]))["pane_id"]')
    direction=right; [[ "$pane_count" -ge 4 ]] && direction=down

    new_pane=$(h pane split "$anchor" --direction "$direction" --cwd "$cwd" --no-focus | json 'd["result"]["pane"]["pane_id"]')
    h agent start "$name" --kind claude --pane "$new_pane" --timeout 60000 >/dev/null
    h pane rename "$new_pane" "$(title_of "$platform")" >/dev/null
    echo "열림: $name pane=$new_pane cwd=$cwd"

    if [[ -n "$prompt_dir" ]]; then
      prompt=""
      [[ -f "$prompt_dir/common.md" ]] && prompt="$(cat "$prompt_dir/common.md")"$'\n\n'
      if [[ -f "$prompt_dir/$platform.md" ]]; then
        prompt+="$(cat "$prompt_dir/$platform.md")"
        h agent prompt "$name" "$prompt" >/dev/null
        echo "  지시 전송: $prompt_dir/$platform.md"
      else
        echo "  지시 파일 없음: $prompt_dir/$platform.md (전송 안 함)"
      fi
    fi
  done

  # 첫 메시지가 승인 대기에 걸렸는지 한 번 본다
  if [[ -n "$prompt_dir" ]]; then
    sleep 8
    for spec in "${specs[@]}"; do
      name="p${project}-${spec%%=*}"
      status=$(h agent get "$name" | json 'd["result"]["agent"]["agent_status"]' 2>/dev/null || echo unknown)
      echo "상태: $name $status"
    done
  fi
  ;;

close)
  [[ -n "$project" ]] || die "--project 가 필요합니다"
  prefix="p${project}-${platform_only}"
  panes=$(agents_json | PREFIX="$prefix" EXACT="$platform_only" python3 -c '
import sys, json, os
prefix, exact = os.environ["PREFIX"], os.environ["EXACT"]
for a in json.load(sys.stdin)["result"]["agents"]:
    name = a.get("name") or ""
    if (name == prefix) if exact else name.startswith(prefix):
        print(a["pane_id"], name, a.get("cwd") or "-")
')
  [[ -n "$panes" ]] || { echo "닫을 ${prefix} 세션이 없습니다"; exit 0; }
  while read -r pane name cwd; do
    [[ "$pane" == "$self_pane" ]] && continue
    # 커밋 안 한 변경이나 push 안 한 커밋이 있으면 닫지 않는다
    if [[ "$force" != 1 && -d "$cwd" ]] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
      dirty=$(git -C "$cwd" status --porcelain | head -5)
      unpushed=$(git -C "$cwd" log --oneline '@{u}..' 2>/dev/null | head -5 || true)
      if [[ -n "$dirty" || -n "$unpushed" ]]; then
        echo "건너뜀: $name ($pane) $cwd 에 커밋 안 한 변경이나 push 안 한 커밋이 있습니다 (--force 로 강제)"
        continue
      fi
    fi
    h pane close "$pane" >/dev/null && echo "닫음: $name ($pane)"
  done <<< "$panes"
  ;;

list)
  agents_json | TAB="$self_tab" PROJECT="$project" python3 -c '
import sys, json, os
tab, project = os.environ["TAB"], os.environ["PROJECT"]
for a in json.load(sys.stdin)["result"]["agents"]:
    name = a.get("name") or "-"
    if a.get("tab_id") != tab or (project and not name.startswith(f"p{project}-")):
        continue
    print(name, a["pane_id"], a.get("agent_status"), a.get("cwd"), sep="\t")
'
  ;;

*)
  die "사용법: work-sessions open|close|list ..."
  ;;
esac
